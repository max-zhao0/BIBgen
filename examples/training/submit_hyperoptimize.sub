universe = container
container_image = /cvmfs/singularity.opensciencegrid.org/htc/pytorch:2.3.1-cuda11.8

log = job_$(Cluster)_$(Process).log
error = job_$(Cluster)_$(Process).err
output = job_$(Cluster)_$(Process).out

executable = run_hyperoptimize.sh
arguments = $(data) $(config) $(out) $(schedule)

+JobDurationCategory = "Long"

gpus_minimum_capability = 7.5
request_gpus = 1

# Blacklist Notre Dame GPUs, comment out later
requirements = (GLIDEIN_ResourceName =!= "ND-CAML-GPU-CE1")
max_retries = 3

request_cpus = 2
request_memory = 8GB
request_disk = 50GB

# Each row's study is kept in a folder named after `out` without .json, e.g. best_equivariant_denoiser/,
# holding the optuna study (best_equivariant_denoiser.db) and, once every trial is done, the best config
# (best_equivariant_denoiser.json). hyperoptimize_rows.sh creates the folder at submit time if it is
# missing, and it is transferred in and back out, so resubmitting the same row resumes the study.
# Delete the folder to start the study over.
study = $Fn(out)
transfer_input_files = hyperoptimize.py, ../../src, ../../config, $(study), osdf:///ospool/uc-shared/project/futurecolliders/rosep8/$(data)
transfer_output_files = $(study)
should_transfer_files = YES

queue data,config,out,schedule from ./hyperoptimize_rows.sh experiments_hyper.txt |
